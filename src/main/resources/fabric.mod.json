{
	"schemaVersion": 1,
	"id": "mob_brain_additions",
	"version": "${version}",
	"name": "Mob Brain Additions",
	"description": "This mod adds features that give additional functionality to mobs that use the brain system.",
	"authors": [
		"TheRedBrain"
	],
	"contact": {
		"sources": "https://github.com/TheRedBrain/mob-brain-additions"
	},
	"license": "MIT",
	"icon": "assets/mob_brain_additions/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.theredbrain.mobbrainadditions.MobBrainAdditions"
		],
		"client": [
			"com.github.theredbrain.mobbrainadditions.MobBrainAdditionsClient"
		]
	},
	"mixins": [
		"mob_brain_additions.mixins.json",
		{
			"config": "mob_brain_additions.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"fabric-api": "*",
		"fzzy_config": ">=${fzzy_config_version}",
		"smartbrainlib": ">=${smart_brain_lib_version}"
	}
}